  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one ochre action per screen (Send & close, Get UPS rates, Buy label, a dirty Save).",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg>Send &amp; close</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 14px;border-radius:7px;border:1px solid var(--border-strong,#cec6bf);background:var(--surface,#fff);color:var(--text,#2b2b2b);font:600 13.5px \"Chivo\",system-ui,sans-serif;cursor:pointer;transition:background .15s cubic-bezier(.16,1,.3,1),border-color .15s cubic-bezier(.16,1,.3,1),transform .1s cubic-bezier(.16,1,.3,1)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--ochre,#c78c2b);outline-offset:2px}.ds-btn-primary{background:var(--ochre,#c78c2b);border-color:var(--ochre,#c78c2b);color:var(--teal-ink,#1a2c2c);box-shadow:0 1px 2px rgba(33,56,56,.08)}.ds-btn-primary:hover{background:var(--ochre-hover,#b57b1d);border-color:var(--ochre-hover,#b57b1d)}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Outlined resting state for Save and secondary actions; Save turns primary only when its form is dirty.",
      "html": "<button class=\"ds-btn-default\">Save</button>",
      "css": ".ds-btn-default{display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 14px;border-radius:7px;border:1px solid var(--border-strong,#cec6bf);background:var(--surface,#fff);color:var(--text,#2b2b2b);font:600 13.5px \"Chivo\",system-ui,sans-serif;cursor:pointer;transition:background .15s cubic-bezier(.16,1,.3,1),transform .1s cubic-bezier(.16,1,.3,1)}.ds-btn-default:hover{background:var(--hover,#f3efea)}.ds-btn-default:active{transform:translateY(1px)}.ds-btn-default:focus-visible{outline:2px solid var(--ochre,#c78c2b);outline-offset:2px}"
    },
    {
      "name": "Dark Button",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Teal strong-secondary for store actions (Ship, Add note, Sign in with Google).",
      "html": "<button class=\"ds-btn-dark\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 17h4V5H2v12h3\"/><path d=\"M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1\"/><circle cx=\"7.5\" cy=\"17.5\" r=\"2.5\"/><circle cx=\"17.5\" cy=\"17.5\" r=\"2.5\"/></svg>Ship</button>",
      "css": ".ds-btn-dark{display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 14px;border-radius:7px;border:1px solid var(--teal,#213838);background:var(--teal,#213838);color:var(--on-teal,#f3efe9);font:600 13.5px \"Chivo\",system-ui,sans-serif;cursor:pointer;transition:background .15s cubic-bezier(.16,1,.3,1)}.ds-btn-dark:hover{background:var(--teal-2,#2b4646)}.ds-btn-dark:active{transform:translateY(1px)}.ds-btn-dark:focus-visible{outline:2px solid var(--ochre,#c78c2b);outline-offset:2px}"
    },
    {
      "name": "Ghost Danger Button",
      "kind": "button",
      "refersTo": "button-ghost-danger",
      "description": "Destructive actions (Delete, Remove, Void, Disconnect): brick text, no border.",
      "html": "<button class=\"ds-btn-ghost-danger\">Delete</button>",
      "css": ".ds-btn-ghost-danger{display:inline-flex;align-items:center;height:30px;padding:0 10px;border-radius:7px;border:1px solid transparent;background:transparent;color:var(--brick,#b03424);font:600 12.5px \"Chivo\",system-ui,sans-serif;cursor:pointer;transition:background .15s cubic-bezier(.16,1,.3,1)}.ds-btn-ghost-danger:hover{background:var(--brick-soft,#f8e3df)}.ds-btn-ghost-danger:focus-visible{outline:2px solid var(--ochre,#c78c2b);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Stone-outlined field with ochre focus and a 3px ochre-wash halo.",
      "html": "<label class=\"ds-field\">Name<input class=\"ds-input\" placeholder=\"name@tufttheworld.com\"></label>",
      "css": ".ds-field{display:grid;gap:5px;font:600 12px \"Chivo\",system-ui,sans-serif;color:var(--text-2,#565049);width:280px}.ds-input{min-height:36px;padding:7px 11px;border-radius:7px;border:1px solid var(--border-strong,#cec6bf);background:var(--surface,#fff);color:var(--text,#2b2b2b);font:400 14px \"Chivo\",system-ui,sans-serif;outline:none;caret-color:var(--ochre,#c78c2b);transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:var(--text-3,#6c655d)}.ds-input:hover{border-color:var(--text-3,#6c655d)}.ds-input:focus{border-color:var(--ochre,#c78c2b);box-shadow:0 0 0 3px var(--ochre-soft,#f7ecd8)}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-open",
      "description": "Pill badges with a leading dot in brand tones: open, pending, good, bad, closed.",
      "html": "<span class=\"ds-badge ds-open\">Open</span> <span class=\"ds-badge ds-pending\">Unfulfilled</span> <span class=\"ds-badge ds-good\">Paid</span> <span class=\"ds-badge ds-bad\">Refunded</span> <span class=\"ds-badge ds-closed\">Closed</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:5px;height:21px;padding:0 8px;border-radius:999px;font:600 11.5px \"Chivo\",system-ui,sans-serif;white-space:nowrap}.ds-badge::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.85}.ds-open{background:#e3eeec;color:var(--teal,#213838)}.ds-pending{background:var(--ochre-soft,#f7ecd8);color:var(--ochre-text,#8a5a10)}.ds-good{background:var(--mint-soft,#e2f5e3);color:var(--mint-ink,#1f5b2b)}.ds-bad{background:var(--brick-soft,#f8e3df);color:var(--brick,#b03424)}.ds-closed{background:var(--sunken,#efebe6);color:var(--text-3,#6c655d)}"
    },
    {
      "name": "Teal Rail",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "The store-teal rail with cut-pile dot texture, wordmark lockup, and ochre-accented active item.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-brand\" href=\"#\"><span class=\"ds-word\">Tuft the World</span><span class=\"ds-sub\">Support desk</span></a><div class=\"ds-nav-label\">Tickets</div><a class=\"ds-nav-item\" href=\"#\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/></svg>Assigned to me<span class=\"ds-count\">1</span></a><a class=\"ds-nav-item ds-active\" href=\"#\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-6l-2 3h-4l-2-3H2\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/></svg>All open<span class=\"ds-count\">3</span></a></nav>",
      "css": ".ds-rail{position:relative;overflow:hidden;width:228px;padding:18px 12px 12px;background:var(--teal,#213838);color:var(--on-teal,#f3efe9);display:flex;flex-direction:column;gap:1px;font-family:\"Chivo\",system-ui,sans-serif}.ds-rail::before{content:\"\";position:absolute;inset:0;pointer-events:none;opacity:.07;background-image:radial-gradient(circle at 50% 50%,#f3efe9 0 1.1px,transparent 1.6px);background-size:7px 7px;-webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 55%);mask-image:linear-gradient(180deg,transparent 0%,#000 55%)}.ds-rail>*{position:relative}.ds-brand{display:grid;gap:3px;padding:2px 10px 22px;text-decoration:none;color:var(--on-teal,#f3efe9)}.ds-word{font:400 21px/1 \"Abril Fatface\",Georgia,serif;letter-spacing:.02em;text-transform:uppercase}.ds-sub{font:700 10.5px \"Chivo\",system-ui,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:var(--ochre,#c78c2b)}.ds-nav-label{font:600 10.5px \"Chivo\",system-ui,sans-serif;text-transform:uppercase;letter-spacing:.16em;color:var(--on-teal-2,#b9c8c4);opacity:.8;padding:16px 10px 7px}.ds-nav-item{display:flex;align-items:center;gap:11px;padding:8px 10px;border-radius:7px;color:var(--on-teal-2,#b9c8c4);text-decoration:none;font-weight:500;font-size:13.5px;transition:background .15s cubic-bezier(.16,1,.3,1),color .15s cubic-bezier(.16,1,.3,1)}.ds-nav-item:hover{background:var(--teal-2,#2b4646);color:var(--on-teal,#f3efe9)}.ds-nav-item:focus-visible{outline:2px solid var(--ochre,#c78c2b);outline-offset:2px}.ds-nav-item.ds-active{background:var(--teal-3,#365555);color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.06)}.ds-nav-item.ds-active svg{color:var(--ochre,#c78c2b)}.ds-count{margin-left:auto;min-width:22px;height:20px;padding:0 6px;border-radius:999px;display:inline-grid;place-items:center;font-size:11.5px;font-weight:700;background:rgba(255,255,255,.07)}.ds-active .ds-count{background:var(--ochre,#c78c2b);color:var(--teal-ink,#1a2c2c)}"
    },
    {
      "name": "Ticket Row",
      "kind": "custom",
      "refersTo": "card",
      "description": "Queue row: ochre unread dot, bold name, ochre-ink time, Roboto snippet; active row lifts to a white card.",
      "html": "<div class=\"ds-list\"><a class=\"ds-row ds-unread\" href=\"#\"><span class=\"ds-top\"><b>Priya Patel</b><span class=\"ds-when\">5h</span></span><span class=\"ds-subj\">Workshop gift card question</span><span class=\"ds-snip\">Can a gift card be used for the Saturday rug workshop at the Bok Building?</span></a><a class=\"ds-row ds-active\" href=\"#\"><span class=\"ds-top\"><b>Jane Doe</b><span class=\"ds-when\">1h</span></span><span class=\"ds-subj\">Where is my tufting gun order?</span><span class=\"ds-snip\">Hi! I ordered the AK-I tufting gun last week and haven't received a tracking number yet.</span></a></div>",
      "css": ".ds-list{width:320px;padding:6px 8px;background:var(--panel,#f8f6f3);font:14px/1.45 \"Chivo\",system-ui,sans-serif;color:var(--text,#2b2b2b)}.ds-row{display:grid;gap:3px;padding:11px 12px 12px 22px;border-radius:7px;margin-bottom:2px;position:relative;text-decoration:none;color:inherit;transition:background .12s cubic-bezier(.16,1,.3,1)}.ds-row:hover{background:var(--hover,#f3efea)}.ds-row:focus-visible{outline:2px solid var(--ochre,#c78c2b);outline-offset:2px}.ds-row.ds-active{background:var(--surface,#fff);box-shadow:0 1px 2px rgba(33,56,56,.08),inset 0 0 0 1px var(--border,#e6e0da)}.ds-unread::before{content:\"\";position:absolute;left:9px;top:17px;width:7px;height:7px;border-radius:50%;background:var(--ochre,#c78c2b)}.ds-top{display:flex;gap:8px;align-items:baseline}.ds-top b{flex:1;font-weight:500}.ds-unread .ds-top b{font-weight:700}.ds-when{font-size:12px;color:var(--text-3,#6c655d)}.ds-unread .ds-when{color:var(--ochre-text,#8a5a10);font-weight:600}.ds-subj{font-size:13.5px;color:var(--text-2,#565049)}.ds-unread .ds-subj{color:var(--text,#2b2b2b)}.ds-snip{font:12.5px/1.45 \"Roboto\",system-ui,sans-serif;color:var(--text-3,#6c655d);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}"
    },
    {
      "name": "Conversation Items",
      "kind": "card",
      "refersTo": "message-in",
      "description": "Incoming white message, outgoing sage message, and dashed parchment internal note.",
      "html": "<div class=\"ds-thread\"><article class=\"ds-msg\"><div class=\"ds-mh\"><b>Marcus Lee</b><span>Oct 1, 8:34 AM</span></div><p>Amazing, thank you! Do you have a tracking number yet?</p></article><article class=\"ds-msg ds-out\"><div class=\"ds-mh\"><b>Tuft the World Support</b><span>Sep 30, 3:34 PM</span></div><p>So sorry about that, Marcus! We'll send Mustard out today.</p></article><div class=\"ds-note\"><div class=\"ds-nh\">Internal note · Tim</div>Replacement packed, ship Ground.</div></div>",
      "css": ".ds-thread{display:flex;flex-direction:column;gap:14px;width:420px;padding:16px;background:var(--bg,#fff)}.ds-msg{background:var(--surface,#fff);border:1px solid var(--border,#e6e0da);border-radius:12px;box-shadow:0 1px 2px rgba(33,56,56,.08);margin-right:auto;width:90%}.ds-msg.ds-out{background:var(--out,#edf3f1);border-color:var(--out-border,#d4e2de);box-shadow:none;margin-left:auto;margin-right:0}.ds-mh{display:flex;gap:10px;padding:12px 16px 0;font:700 13.5px \"Chivo\",system-ui,sans-serif;color:var(--text,#2b2b2b)}.ds-mh span{margin-left:auto;font-weight:400;font-size:12px;color:var(--text-3,#6c655d)}.ds-msg p{margin:0;padding:10px 16px 14px;font:14.5px/1.6 \"Roboto\",system-ui,sans-serif;color:var(--text,#2b2b2b)}.ds-note{background:var(--note,#fbf2df);border:1px dashed var(--note-border,#ecd6a6);border-radius:12px;padding:11px 16px 12px;margin-right:auto;font:14px/1.55 \"Roboto\",system-ui,sans-serif;color:var(--text,#2b2b2b)}.ds-nh{font:700 12px \"Chivo\",system-ui,sans-serif;color:var(--ochre-text,#8a5a10);margin-bottom:4px}"
    },
    {
      "name": "Inbox Zero Rug",
      "kind": "custom",
      "description": "Empty-inbox art: a round tufted rug from above in brand yarns, above a short title and message.",
      "html": "<div class=\"ds-empty\"><svg width=\"120\" height=\"120\" viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"54\" fill=\"#213838\"/><circle cx=\"60\" cy=\"60\" r=\"46\" fill=\"none\" stroke=\"#c78c2b\" stroke-width=\"7\" stroke-dasharray=\"3 2.4\"/><circle cx=\"60\" cy=\"60\" r=\"35\" fill=\"none\" stroke=\"#cec6bf\" stroke-width=\"7\" stroke-dasharray=\"3 2.4\"/><circle cx=\"60\" cy=\"60\" r=\"24\" fill=\"none\" stroke=\"#b03424\" stroke-width=\"7\" stroke-dasharray=\"3 2.4\"/><circle cx=\"60\" cy=\"60\" r=\"13\" fill=\"#b4eaba\"/><path d=\"M54 60.5l4.2 4.2L67 56\" fill=\"none\" stroke=\"#213838\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><h2>Inbox zero</h2><p>Nothing waiting. New email shows up here.</p></div>",
      "css": ".ds-empty{padding:56px 28px;text-align:center;display:grid;justify-items:center;gap:6px;color:var(--text-3,#6c655d);font:14px/1.5 \"Chivo\",system-ui,sans-serif}.ds-empty svg{margin-bottom:4px}.ds-empty h2{margin:6px 0 0;font:700 17px \"Chivo\",system-ui,sans-serif;color:var(--text,#2b2b2b)}.ds-empty p{margin:0;max-width:34ch}"
    }
  ],
  "narrative": {
    "northStar": "The Shop Counter",
    "overview": "This is the store's own counter, not a SaaS dashboard. The helpdesk wears the Tuft the World shopfront: the deep teal of the store's top bar becomes a full-height rail, ochre is the colour of the one thing to do next, and everything else is white paper and warm stone hairlines. The work surface is a dense, quiet three-pane desk (queue, conversation, customer with orders) built for fast passes through a short queue, with the brand carried by colour, type and one material detail rather than by decoration.\n\nThe material detail is yarn. The rail carries a faint cut-pile texture, a 7px grid of dots like the back of a tufted rug, fading in from the top. The same material returns in the inbox-zero art, a round tufted rug seen from above in brand yarns. Mail is set in Roboto so customers' words read like a letter; the interface around them is set in Chivo; Abril Fatface appears only in the wordmark.\n\nThe system ships both schemes from one token set. Dark mode keeps the teal rail, warms the neutrals to a dark brown-grey paper, and lightens ochre and brick so they still read as text.",
    "keyCharacteristics": [
      "Teal rail, white work surface, warm-stone hairlines; a second neutral layer (panel) behind the list and customer columns.",
      "One ochre primary action per screen; everything else is outlined, dark teal, or ghost.",
      "Chivo for UI, Roboto for mail and descriptive copy, Abril Fatface for the wordmark only.",
      "Status is spoken in brand tones: teal open, ochre pending, mint good, brick bad, sunken closed.",
      "Flat surfaces with hairline borders; shadows are a whisper (shadow-sm) except for floating layers.",
      "Motion is short and decelerating (150–250ms on a single ease-out curve), and is removed under reduced motion."
    ],
    "rules": [
      {
        "name": "The One Ochre Rule",
        "body": "Each screen has at most one filled ochre button. Save buttons render as outlined default buttons and only turn ochre when their own card or saved-reply row becomes dirty; they drop back after a successful save.",
        "section": "colors"
      },
      {
        "name": "The Brand Tone Rule",
        "body": "Status is coloured only with brand tones: teal for open, ochre for pending or warning, mint for good, brick for bad, sunken stone for closed. No other hue is introduced for state.",
        "section": "colors"
      },
      {
        "name": "The Teal Is The Store Rule",
        "body": "Teal is the structural brand surface (rail, toasts, dark buttons, success). It is never used as a large fill inside the work area other than the shipping success card.",
        "section": "colors"
      },
      {
        "name": "The Wordmark Only Rule",
        "body": "Abril Fatface sets the brand wordmark and nothing else: never a heading, number, or empty-state title.",
        "section": "typography"
      },
      {
        "name": "The Letter And Desk Rule",
        "body": "Words the customer wrote, or words that will be sent to them, are set in Roboto. Words the interface speaks are set in Chivo.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Numerals are tabular everywhere so counts, times and prices align in lists.",
        "section": "typography"
      },
      {
        "name": "The Whisper Rule",
        "body": "Resting surfaces get at most the hairline lift. The float shadow is reserved for layers that overlap content.",
        "section": "elevation"
      },
      {
        "name": "The Outgoing Is Flat Rule",
        "body": "Outgoing messages drop their shadow and take the sage tint; incoming messages keep the hairline lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep a single filled ochre action per screen; render every other action outlined, dark teal, or ghost, and let Save turn ochre only when its own form is dirty.",
      "**Do** colour status with the brand tones only: teal-soft/teal (open), ochre-soft/ochre-text (pending), mint-soft/mint-ink (good), brick-soft/brick (bad), sunken/text-3 (closed).",
      "**Do** set customer and outgoing mail in Roboto 14.5px/1.6 and interface text in Chivo 14px/1.45 with tabular numerals.",
      "**Do** separate panes and rows with 1px stone hairlines and the white-on-panel tonal step before reaching for shadow.",
      "**Do** animate with the one ease-out curve, cubic-bezier(.16, 1, .3, 1), at 150ms for state changes and 180–250ms for entrances (menus, toasts, sheet), and honour reduced motion.",
      "**Do** show loading as skeleton rows shaped like the content they replace.",
      "**Do** use the dot grid (radial dots on a 7–9px pitch, 7–8% opacity) only on teal brand surfaces: the rail and the login ground."
    ],
    "donts": [
      "**Don't** set anything but the wordmark in Abril Fatface.",
      "**Don't** introduce a second accent hue or a generic success green; good is mint, danger is brick.",
      "**Don't** use brick for anything but destructive actions, errors and link hover.",
      "**Don't** put uppercase letter-spaced labels above content headings; tracked uppercase lives only in the wordmark lockup and the rail group headers.",
      "**Don't** give resting cards anything heavier than the hairline lift, or use offset hard shadows.",
      "**Don't** fill large areas of the work surface with teal; the rail, toasts, dark buttons and the shipping success card are its places."
    ]
  }
}